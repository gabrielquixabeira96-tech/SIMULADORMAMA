# Copie para .env (raiz) ou apps/web/.env.local. NUNCA commite .env*.
# Todos os valores abaixo sao locais e nao clinicos.

# ---- Feature flag regulatoria (ADR 0005) ----
# B = mede e calcula (piloto in house, art. 5 RDC 657). A = cirurgiao digita e escolhe.
DESENHO=B

# ---- Versao / ambiente ----
APP_ENV=local
# Fuso usado em relatorios e auditoria (Cuiaba)
TZ=America/Cuiaba

# ---- Banco (ADR 0007). Local = Postgres 16 nativo; producao = Postgres em sa-east-1 (ADR 0004) ----
DATABASE_URL=postgres://simulador:simulador@127.0.0.1:5432/simulador
# Producao (NAO usar aqui; exemplo do alvo): postgres://<user>:<senha>@db.<projeto>.supabase.co:5432/postgres  # regiao sa-east-1
# Testes usam um banco separado:
DATABASE_URL_TEST=postgres://simulador:simulador@127.0.0.1:5432/simulador_test

# ---- Arquivos (malhas, texturas, PDFs). Relativo a raiz do repo ou absoluto. Esta no .gitignore. ----
DATA_DIR=./data

# ---- Servico de malha Python (docs/contratos.md secao 7) ----
MESH_SERVICE_URL=http://127.0.0.1:8765
MESH_SERVICE_TIMEOUT_MS=1800000

# ---- LLM (ADR 0006). Sem ANTHROPIC_API_KEY => modo mock. ----
LLM_MODO=mock
# ANTHROPIC_API_KEY=
# IDs de modelo por variavel, nunca hard-coded. Preencher com os IDs vigentes da Anthropic.
LLM_MODELO_ANAMNESE=<id-do-modelo-rapido>
LLM_MODELO_RELATORIO=<id-do-modelo-padrao>
LLM_MAX_TOKENS=2000
# Opcional. Modelos recentes recusam temperature diferente de 1; so defina se o modelo aceitar.
# LLM_TEMPERATURA=

# ---- Incerteza exibida (mm RMS). Padrao vem de config/simulacao.json; aqui so sobrescreve. ----
# ENVELOPE_RMS_MM=4.5

# ---- Web ----
PORT=3000
# Token local (ADR 0003, revisao v0.1.1). O app so escuta em 127.0.0.1 e exige este token em toda
# rota: abra uma vez http://127.0.0.1:3000/?token=<APP_TOKEN_LOCAL> (vira cookie HttpOnly) ou mande
# "Authorization: Bearer <APP_TOKEN_LOCAL>". OBRIGATORIO em `next start`; em `next dev` pode ficar vazio.
# Gere um valor aleatorio:  openssl rand -hex 24
APP_TOKEN_LOCAL=
# Hosts extras aceitos alem de 127.0.0.1/localhost/::1 (separados por virgula). Vazio = so loopback.
# APP_HOSTS_PERMITIDOS=
# Limite do upload de malhas em MB (padrao 500; ADR 0003)
# UPLOAD_MAX_MB=500
# Usuario unico local nesta fase (sem auth externa). Vai para auditoria.usuario_id
USUARIO_LOCAL_ID=local

# ---- Benchmark de latencia no hardware-alvo (plano A14) ----
# 1 = liga a pagina /benchmark e as rotas /api/benchmark*; qualquer outro valor ou vazio = 404
# (DESLIGADO por padrao). Variavel de SERVIDOR, lida em runtime (nunca NEXT_PUBLIC_*). Usa so o
# torso sintetico t01_simetrico_300 (bash scripts/mesh.sh torsos), processado em
# DATA_DIR/benchmark/, fora de pacientes/ e sem banco; nenhum dado de paciente. Continua atras do
# token local (ADR 0003). Na instancia normal (com dados de pacientes) use so em loopback.
#
# Medir num iPad (ADR 0003, revisao v0.1.2 -- excecao controlada): o iPad precisa alcancar a app
# pela rede local, e o trafego e HTTP sem TLS. NUNCA faca isso na instancia que tem dados de
# pacientes. Suba uma instancia SEPARADA, so para o benchmark:
#   - DATA_DIR proprio, sem pacientes/ (vazio ou so sinteticos/ e benchmark/);
#   - DATABASE_URL VAZIO (os pacientes ficam no Postgres; o benchmark nao usa banco) -- nao copie
#     o .env da instancia normal;
#   - BENCHMARK_HABILITADO=1 e APP_HOSTS_PERMITIDOS=<ip-da-maquina>; escutar fora do loopback
#     (next start -H <ip-da-maquina>) so nessa instancia;
#   - APP_TOKEN_LOCAL forte e exclusivo dela (openssl rand -hex 24), diferente do da instancia normal;
#   - so em rede confiavel (sem Wi-Fi publico/de convidados);
#   - desligue a instancia assim que baixar o JSON (e apague o DATA_DIR temporario).
# Esse modo (BENCHMARK_HABILITADO=1 + host fora do loopback em APP_HOSTS_PERMITIDOS) e imposto
# pelo servidor, pela configuracao e nao pelo Host da requisicao: a subida RECUSA se DATABASE_URL
# estiver definido ou se DATA_DIR/pacientes existir; e o proxy so atende exatamente /benchmark,
# /api/benchmark e /api/benchmark/arquivo -- qualquer outra rota -> 403 rota_restrita_benchmark,
# com qualquer Host (inclusive localhost). Abra no iPad
# http://<ip-da-maquina>:<porta>/benchmark?token=<APP_TOKEN_LOCAL>. O JSON baixado vira registro com
# python3 scripts/importar_latencia.py <arquivo>.json --rotulo ipad
BENCHMARK_HABILITADO=

# ---- Demonstracao sintetica na rede (ADR 0018; v0.1.3 em desenvolvimento) ----
# 1 = instancia DEDICADA de demonstracao (ex.: Vercel Sandbox por HTTPS), so com torsos sinteticos.
# DESLIGADO por padrao (vazio ou 0); qualquer outro valor faz a subida recusar. Nao use nesta
# instancia: suba com `bash scripts/demo_sandbox.sh` (docs/deploy-demo.md), que gera banco,
# DATA_DIR e token proprios. Com 1: POST /api/malhas e POST /api/llm/anamnese -> 403
# desligado_na_demo; so torsos gerados pelo services/mesh; faixa "DEMONSTRACAO" em todas as
# paginas; /benchmark ligado; o modo "benchmark na rede" acima NAO se aplica (o app inteiro
# atende no host de APP_HOSTS_PERMITIDOS, sempre com token). A subida RECUSA: ANTHROPIC_API_KEY
# definida, LLM_MODO diferente de mock, APP_TOKEN_LOCAL fraco (< 32 caracteres ou entropia baixa),
# DATABASE_URL vazio, banco sem a marca de demo, malha nao sintetica, anamnese gravada ou pasta
# estranha em DATA_DIR/pacientes. NUNCA com dado real.
DEMO_SINTETICA=
# Atras de proxy TLS (terminacao HTTPS fora do Next): 1 = confiar em X-Forwarded-Proto/-Host para
# o redirecionamento do ?token= (https://) e o cookie Secure. Implicito com DEMO_SINTETICA=1;
# fora disso, so ligue se o Next estiver ATRAS de um proxy que sobrescreve esses cabecalhos.
# APP_CONFIAR_PROXY_TLS=
