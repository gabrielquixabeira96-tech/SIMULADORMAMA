# Copie para .env (raiz) ou apps/web/.env.local. NUNCA commite .env*.
# Todos os valores abaixo sao locais e nao clinicos.

# ---- Feature flag regulatoria (ADR 0005) ----
# B = mede e calcula (piloto in house, art. 5 RDC 657). A = cirurgiao digita e escolhe.
DESENHO=B

# ---- Versao / ambiente ----
APP_ENV=local
# Fuso usado em relatorios e auditoria (Cuiaba)
TZ=America/Cuiaba

# ---- Banco (ADR 0007). Local = Postgres 16 nativo; producao = Postgres em sa-east-1 (ADR 0004) ----
DATABASE_URL=postgres://simulador:simulador@127.0.0.1:5432/simulador
# Producao (NAO usar aqui; exemplo do alvo): postgres://<user>:<senha>@db.<projeto>.supabase.co:5432/postgres  # regiao sa-east-1
# Testes usam um banco separado:
DATABASE_URL_TEST=postgres://simulador:simulador@127.0.0.1:5432/simulador_test

# ---- Arquivos (malhas, texturas, PDFs). Relativo a raiz do repo ou absoluto. Esta no .gitignore. ----
DATA_DIR=./data

# ---- Servico de malha Python (docs/contratos.md secao 7) ----
MESH_SERVICE_URL=http://127.0.0.1:8765
MESH_SERVICE_TIMEOUT_MS=1800000

# ---- LLM (ADR 0006). Sem ANTHROPIC_API_KEY => modo mock. ----
LLM_MODO=mock
# ANTHROPIC_API_KEY=
# IDs de modelo por variavel, nunca hard-coded. Preencher com os IDs vigentes da Anthropic.
LLM_MODELO_ANAMNESE=<id-do-modelo-rapido>
LLM_MODELO_RELATORIO=<id-do-modelo-padrao>
LLM_MAX_TOKENS=2000

# ---- Incerteza exibida (mm RMS). Padrao vem de config/simulacao.json; aqui so sobrescreve. ----
# ENVELOPE_RMS_MM=4.5

# ---- Web ----
PORT=3000
# Usuario unico local nesta fase (sem auth externa). Vai para auditoria.usuario_id
USUARIO_LOCAL_ID=local
