{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://simulador-mamario.local/schemas/torso_parametros.schema.json",
  "title": "torso_parametros/1.1",
  "description": "Parametros de entrada do gerador de torso sintetico (docs/contratos.md secao 4.1). Unidades: mm e mL. A 1.1 acrescenta `forma` e `parede` opcionais (template ajustado a fotos); ausentes = comportamento da 1.0 byte a byte.",
  "type": "object",
  "additionalProperties": false,
  "required": ["esquema", "nome", "semente", "largura_toracica_mm", "volume_ml", "ptose", "n_imf_mm", "assimetria"],
  "properties": {
    "esquema": { "enum": ["torso_parametros/1.0", "torso_parametros/1.1"] },
    "nome": { "type": "string", "pattern": "^[a-z0-9_]+$" },
    "semente": { "type": "integer", "minimum": 0 },
    "largura_toracica_mm": { "type": "number", "minimum": 220, "maximum": 420 },
    "altura_torso_mm": { "type": "number", "minimum": 300, "maximum": 600, "default": 450 },
    "profundidade_toracica_mm": { "type": "number", "minimum": 140, "maximum": 300, "default": 200 },
    "volume_ml": { "$ref": "#/$defs/porLado", "properties": { "dir": { "type": "number", "minimum": 0, "maximum": 1200 }, "esq": { "type": "number", "minimum": 0, "maximum": 1200 } } },
    "ptose": { "$ref": "#/$defs/porLado", "properties": { "dir": { "type": "number", "minimum": 0, "maximum": 1 }, "esq": { "type": "number", "minimum": 0, "maximum": 1 } } },
    "n_imf_mm": { "$ref": "#/$defs/porLado", "properties": { "dir": { "type": "number", "minimum": 40, "maximum": 140 }, "esq": { "type": "number", "minimum": 40, "maximum": 140 } } },
    "assimetria": {
      "type": "object",
      "additionalProperties": false,
      "required": ["delta_altura_mamilo_mm", "delta_lateral_mamilo_mm"],
      "properties": {
        "delta_altura_mamilo_mm": { "type": "number", "minimum": -40, "maximum": 40 },
        "delta_lateral_mamilo_mm": { "type": "number", "minimum": -40, "maximum": 40 }
      }
    },
    "resolucao": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "densa_faces": { "type": "integer", "minimum": 50000, "maximum": 2000000, "default": 300000 },
        "decimada_vertices": { "type": "integer", "minimum": 30000, "maximum": 50000, "default": 40000 }
      }
    },
    "textura": {
      "description": "Textura procedural do torso (docs/contratos.md secao 4.5; ADR 0020). Sem imagem real: tudo gerado por codigo. Ausente = esquematico (a neutra do Marco 0).",
      "type": "object",
      "additionalProperties": false,
      "required": ["realismo"],
      "properties": {
        "realismo": { "enum": ["esquematico", "fotografico"], "default": "esquematico" },
        "fototipo": { "enum": ["I", "II", "III", "IV", "V", "VI"], "default": "III" },
        "px_por_mm": { "type": "number", "minimum": 1, "maximum": 8, "default": 4 },
        "areola_mm": { "type": "number", "minimum": 25, "maximum": 70, "default": 40 },
        "mamilo_mm": { "type": "number", "minimum": 5, "maximum": 16, "default": 10 }
      }
    },
    "forma": {
      "description": "1.1: fatores de forma por lado (superficie.py). Ausentes = padrao (comportamento da 1.0).",
      "type": "object",
      "additionalProperties": false,
      "properties": { "dir": { "$ref": "#/$defs/formaLado" }, "esq": { "$ref": "#/$defs/formaLado" } }
    },
    "parede": {
      "description": "1.1: forma da parede toracica. Ausente = superelipse q = 3 sem achatamento.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "expoente_secao": { "type": "number", "minimum": 2.2, "maximum": 6, "default": 3 },
        "achatamento_anterior": { "type": "number", "minimum": -0.5, "maximum": 0.8, "default": 0 }
      }
    }
  },
  "$defs": {
    "porLado": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dir", "esq"],
      "properties": { "dir": { "type": "number" }, "esq": { "type": "number" } }
    },
    "formaLado": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "base_fator": { "type": "number", "minimum": 0.6, "maximum": 1.6, "default": 1, "description": "multiplica a largura da base (e_med e e_lat)" },
        "apice_fator": { "type": "number", "minimum": -0.4, "maximum": 0.6, "default": 0, "description": "deslocamento extra do apice acima do mamilo, em fracao de n_imf" },
        "polo_superior_fator": { "type": "number", "minimum": 0.5, "maximum": 1.8, "default": 1, "description": "multiplica a altura da pegada acima do apice (e_sup)" },
        "polo_inferior_fator": { "type": "number", "minimum": 0, "maximum": 2.2, "default": 1, "description": "multiplica o termo angular do expoente no polo inferior" },
        "largura_pegada_fator": { "type": "number", "minimum": 0.6, "maximum": 1.6, "default": 1, "description": "multiplica so a extensao lateral da pegada (e_lat)" },
        "projecao_fator": { "type": "number", "minimum": 0.5, "maximum": 2, "default": 1, "description": "multiplica o expoente do perfil inteiro (mais projecao no apice para o mesmo volume)" }
      }
    }
  }
}
