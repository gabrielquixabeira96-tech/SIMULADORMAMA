# ---- Dados de paciente e artefatos gerados (LGPD: nunca no repositorio) ----
# DATA_DIR na raiz E qualquer pasta "data/" em qualquer nivel (ex.: services/mesh/data se alguem
# rodar com DATA_DIR relativo ao cwd). So o README da raiz e versionado.
data/*
**/data/**
!/data/README.md
# Malhas, nuvens de pontos e cenas 3D
*.obj
*.ply
*.glb
*.gltf
*.mtl
*.stl
*.fbx
*.dae
*.3mf
*.usdz
*.usd
*.e57
*.las
*.laz
*.pcd
*.xyz
*.pts
# Texturas e imagens (scans exportam JPG/PNG de textura; nada de imagem no repositorio)
*.png
*.jpg
*.jpeg
*.webp
*.heic
*.heif
*.tif
*.tiff
*.tga
*.exr
*.hdr
*.bmp
# Pacotes de upload (OBJ+MTL+textura zipados)
*.zip
# Fixtures sinteticas pequenas (<1 MB) de testes podem ser commitadas apenas nestas pastas explicitas:
!**/tests/fixtures/**
!**/__fixtures__/**
# (nao ha imagens reais de nudez em lugar nenhum; texturas sinteticas ficam em data/)

# ---- Segredos e ambiente ----
.env
.env.*
!.env.example
*.pem
*.p12
*.pfx

