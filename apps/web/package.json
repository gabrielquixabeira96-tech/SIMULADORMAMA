{
  "name": "web",
  "version": "0.0.1",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "dev": "next dev -H 127.0.0.1",
    "build": "next build",
    "start": "next start -H 127.0.0.1",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "NEXT_PUBLIC_GANCHOS_TESTE=1 next build && playwright test",
    "db:migrate": "node --experimental-strip-types scripts/migrar.ts",
    "db:migrate:test": "node --experimental-strip-types scripts/migrar.ts --teste",
    "validacao:marcos": "NEXT_PUBLIC_GANCHOS_TESTE=1 next build && RELATORIO_VALIDACAO=1 playwright test --project=desenho-B e2e/validacao.spec.ts",
    "validacao:latencia": "NEXT_PUBLIC_GANCHOS_TESTE=1 next build && RELATORIO_VALIDACAO=1 playwright test --project=desenho-B e2e/latencia.spec.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "@next/env": "16.3.6",
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.1",
    "@simulador/contratos": "workspace:*",
    "fflate": "^0.8.2",
    "next": "16.3.6",
    "pdf-lib": "^1.17.1",
    "pg": "^8.16.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "three": "0.186.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.18.0",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@types/three": "0.186.0",
    "eslint": "^9.39.1",
    "eslint-config-next": "16.3.6",
    "jsdom": "^27.0.1",
    "msw": "^2.11.6",
    "pdfjs-dist": "^6.3.289",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
